
# Public browser values from EmailJS. Never add a private key or email password.
# Set template To Email = {{to_email}} and Reply-To = {{email}}.
# Add these same variables to Vercel and redeploy for production.
VITE_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY
VITE_EMAILJS_TEMPLATE=YOUR_TEMPLATE_ID

# Server-only Telegram settings. Never prefix these with VITE_.
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID
# Only needed for language buttons on the deployed site; match this in Vercel.
TELEGRAM_WEBHOOK_SECRET=YOUR_RANDOM_WEBHOOK_SECRET
